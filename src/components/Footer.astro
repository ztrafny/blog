---
import Default from '@astrojs/starlight/components/Footer.astro';

const { entry } = Astro.locals.starlightRoute;
const { date, tags } = entry.data as { date?: Date; tags?: string[] };

const formattedDate = date
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    }).format(date)
  : null;

const isoDate = date ? date.toISOString().split('T')[0] : null;
const showMeta = formattedDate || (tags && tags.length > 0);
---

{
  showMeta && (
    <div class="post-meta">
      {formattedDate && (
        <time class="post-date" datetime={isoDate}>
          {formattedDate}
        </time>
      )}
      {tags && tags.length > 0 && (
        <ul class="post-tags" aria-label="Tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </div>
  )
}

<Default><slot /></Default>

<style>
  .post-meta {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-hairline);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .post-date {
    font-family: 'Fraunces', Georgia, 'Times New Roman', serif;
    font-weight: 500;
    font-style: italic;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-text-muted);
    letter-spacing: 0.01em;
  }

  .post-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-tags li {
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--sl-color-bg-accent);
    color: var(--sl-color-text-accent);
    border: 1px solid var(--sl-color-hairline);
  }
</style>
